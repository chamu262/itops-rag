# Copy to .env and fill in. Never commit .env.
# Only needed for `itops-rag ask` (answers). Search, ingest and eval run locally with no key.
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Optional overrides (defaults shown)
# ITOPS_RAG_INDEX_DIR=.itops-rag/index
# ITOPS_RAG_STORE=auto                 # auto | sqlite | chroma
# ITOPS_RAG_ANSWER_MODEL=claude-opus-5-5
# ITOPS_RAG_FAST_MODEL=claude-haiku-5-5
# ITOPS_RAG_EFFORT=medium              # low | medium | high | xhigh | max
# ITOPS_RAG_MONTHLY_BUDGET_USD=25
# ITOPS_RAG_DEFAULT_ROLE=it-staff      # public | it-staff | security
# ITOPS_RAG_VERIFY_ANSWERS=false       # adds a cheap Haiku faithfulness check per answer
# ITOPS_RAG_REWRITE_QUERIES=false

# Slack bot stub (only if you run it)
# SLACK_BOT_TOKEN=xoxb-your-token
# SLACK_SIGNING_SECRET=your-signing-secret
